{
  "name": "upwork-blaster",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "verify": "npm run typecheck && node --test",
    "typecheck": "next typegen && tsc --noEmit",
    "dev": "next dev -p 4281",
    "build": "next build",
    "start": "next start -p 4280",
    "db:migrate": "node --disable-warning=ExperimentalWarning scripts/db.ts migrate",
    "db:backup": "bash scripts/run_db_backup.sh",
    "clickup": "node loop/scripts/with_doppler.mjs node loop/scripts/clickup.mjs",
    "doctor": "node loop/scripts/doctor.mjs",
    "test:loop": "node --test \"loop/**/*.test.js\" \"loop/**/*.test.mjs\""
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
